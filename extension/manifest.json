{
  "manifest_version": 3,
  "name": "Body Double Tracker",
  "version": "1.3",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
